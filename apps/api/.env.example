DATABASE_URL="postgresql://primefit:primefit@localhost:5433/primefit?schema=public"
PORT=3001
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"
NODE_ENV=development

# --- Auth ---
# When true, Bearer tokens starting with "dev:" are accepted without Firebase
AUTH_DEV_MODE=true
FIREBASE_PROJECT_ID=
# Path to Firebase service account JSON (required when AUTH_DEV_MODE=false)
GOOGLE_APPLICATION_CREDENTIALS=

# --- Observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Storage ---
# local | r2
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:3001/api/media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Set true in production to refuse silent local fallback when STORAGE_DRIVER=r2
STORAGE_STRICT=false
# Local disk is allowed only in development/test unless explicitly overridden.
STORAGE_ALLOW_LOCAL=false

# --- AI ---
OPENAI_API_KEY=
# When false, AI insights go to clients immediately (demo). When true, require coach approval.
AI_REQUIRE_COACH_APPROVAL=true

# --- Wearables ---
WEARABLE_DEMO=true
WEARABLE_AGGREGATOR=
# Required for signed Garmin/WHOOP OAuth state when WEARABLE_DEMO=false
WEARABLE_OAUTH_STATE_SECRET=
TERRA_API_KEY=
VITAL_API_KEY=
SPIKE_APPLICATION_ID=
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=
# Garmin partner-specific OAuth token-exchange endpoint, if supported for your account
GARMIN_TOKEN_URL=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=

# --- Nutrition licensed APIs ---
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
SPOONACULAR_API_KEY=

# --- Exercise media ---
EXERCISE_MEDIA_PROVIDER=free_exercise_db
EXERCISE_MEDIA_CDN_BASE=

# --- Stream Chat (optional; falls back to Postgres chat) ---
STREAM_API_KEY=
STREAM_API_SECRET=

# --- Agora (live credentials required; demo URLs only when explicitly enabled) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_DEMO=true

# --- Razorpay (live credentials required; demo orders only when explicitly enabled) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_DEMO=true
